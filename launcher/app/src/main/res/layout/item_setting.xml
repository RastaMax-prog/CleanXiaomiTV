<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings menu row: item_input, compact, so the longer menu stays small on screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/setting_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="9dp"
    android:paddingEnd="9dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="12dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:singleLine="true" />

    <View
        android:id="@+id/dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/status_dot" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="9sp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.04" />
</LinearLayout>
