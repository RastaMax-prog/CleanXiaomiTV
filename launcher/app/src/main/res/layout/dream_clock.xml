<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow, or over
     photos of the day (dream_photos), with the weather and, near the bottom, athkar (dream_athkar). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Two photo layers, so a new photo can fade in over the old one. -->
    <ImageView
        android:id="@+id/dreamPhotoA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/dreamPhotoB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <!-- Darkens the photo so the text stays readable; shown with the photos. -->
    <View
        android:id="@+id/dreamScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Bottom left: album art, song and artist while a music app plays (now_playing). -->
    <LinearLayout
        android:id="@+id/dreamNowPlaying"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="44dp"
        android:layout_marginStart="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/dreamArt"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dreamSong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="left"
                android:textColor="#F2FFFFFF"
                android:textSize="20sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/dreamArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxWidth="300dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="left"
                android:textColor="#A6FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top right: the photo's credit, small and faint. -->
    <TextView
        android:id="@+id/dreamCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:maxWidth="380dp"
        android:gravity="right"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#59FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/outfit"
        android:alpha="0" />

    <!-- Top left: clock, date and weather. ClockDream shifts it a few pixels every minute. -->
    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="84sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 200"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#8CFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />

        <!-- Weather ("23°  ·  Casablanca"), from the home screen's weather settings. -->
        <TextView
            android:id="@+id/dreamWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:visibility="gone" />

        <!-- Today's prayer times (dream_prayer): a column per prayer, filled in by ClockDream, the next one
             lit, and its countdown under the row. -->
        <LinearLayout
            android:id="@+id/dreamPrayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/dreamPrayerRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/dreamPrayerLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#A6FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom right: a thikr and its source (dream_athkar), right-aligned. -->
    <LinearLayout
        android:id="@+id/dreamAthkar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="44dp"
        android:layout_marginEnd="56dp"
        android:gravity="right"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/dreamThikr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="460dp"
            android:gravity="right"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.25"
            android:textColor="#E6FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/dreamThikrSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="right"
            android:textColor="#73FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
